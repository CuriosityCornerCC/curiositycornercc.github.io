---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Banner from '../components/Banner.astro';
import FeatureCard from '../components/FeatureCard.astro';

let sortedPosts = [];
try {
  const posts = await getCollection('blog');
  if (posts) {
    sortedPosts = posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
  }
} catch (e) {
  console.error("Content collection error:", e);
  sortedPosts = [];
}
---

<BaseLayout title="Curiosity Corner | Homepage" description="A place to explore...">
  <Banner
    title="Welcome to the Corner"
    subtitle=""
    description="Curiosity Corner is a space where we explore the world through crafts, handy work, and shared experiences. Nominally, this is a creative blog and a shop for handmade goods. In reality, it is a dictatorship run by a chonky, 2-year-old ginger cat named Dexter (our CEO) and operated by a human assistant who prefers to stay out of the limelight but fortunately possesses the disposable thumbs required to write, build, and type everything."
    buttonText="Find out who we are"
    buttonLink="/about"
    imageSrc="/images/about/Dexter_with_scarf.jpg"
  />

  <section>
    <header class="major">
      <h2>Latest Articles</h2>
    </header>
    <div class="posts">
      {sortedPosts.length > 0 ? (
        sortedPosts.map((post) => (
          <article>
            <a href={`/blog/${post.slug || post.id}`} class="image">
              <img src={post.data.image || "/images/pic01.jpg"} alt={post.data.title} />
            </a>
            {post.data.category && (
               <p style="margin-bottom: 0.5em;"><a href={`/category/${post.data.category.toLowerCase()}`} class="button small" style="box-shadow: none; padding: 0;"><strong>{post.data.category}</strong></a></p>
            )}
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <ul class="actions">
              <li><a href={`/blog/${post.slug || post.id}`} class="button">Read more</a></li>
            </ul>
          </article>
        ))
      ) : (
        <p>No blog posts found. Add your first Markdown post in <code>src/content/blog/</code>.</p>
      )}
    </div>
  </section>
</BaseLayout>