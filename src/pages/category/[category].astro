---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');

  // Extract unique categories (lowercased)
  const categories = [
    ...new Set(
      allPosts
        .map((post) => post.data.category)
        .filter((cat): cat is string => Boolean(cat))
        .map((cat) => cat.toLowerCase())
    ),
  ];

  return categories.map((category) => {
    const filteredPosts = allPosts.filter(
      (post) => post.data.category && post.data.category.toLowerCase() === category
    );
    return {
      params: { category },
      props: { posts: filteredPosts, categoryName: category },
    };
  });
}

const { category } = Astro.params;
const { posts, categoryName } = Astro.props;

const formattedTitle = categoryName
  ? categoryName.charAt(0).toUpperCase() + categoryName.slice(1)
  : category;
---

<BaseLayout title={`Category: ${formattedTitle} | Curiosity Corner`}>
  <section>
    <header class="main">
      <h1>Category: {formattedTitle}</h1>
    </header>

    <div class="posts">
      {
        posts && posts.length > 0 ? (
          posts.map((post) => (
            <article>
              {post.data.image && (
                <a href={`/blog/${post.slug || post.id}`} class="image">
                  <img src={post.data.image} alt={post.data.title} />
                </a>
              )}
              <h3>{post.data.title}</h3>
              {post.data.description && <p>{post.data.description}</p>}
              <ul class="actions">
                <li>
                  <a href={`/blog/${post.slug || post.id}`} class="button">
                    More
                  </a>
                </li>
              </ul>
            </article>
          ))
        ) : (
          <p>No posts found in this category.</p>
        )
      }
    </div>
  </section>
</BaseLayout>