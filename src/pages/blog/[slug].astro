---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GoogleBusinessCard from '../../components/GoogleBusinessCard.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const { location } = post.data;
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="post">
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <p class="post-meta">
        Published on {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        {post.data.category && ` · Category: ${post.data.category}`}
      </p>
      {post.data.heroImage && (
        <img src={post.data.heroImage} alt={post.data.title} class="hero-image" />
      )}
    </header>

    <div class="post-content">
      <Content />
    </div>

    {location && (
      <section class="post-location">
        <h2>Location & Business Details</h2>
        <GoogleBusinessCard {...location} />
      </section>
    )}
  </article>
</BaseLayout>