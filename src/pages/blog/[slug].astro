---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecipeCard from '../../components/RecipeCard.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug || post.id },
    props: { post },
  }));
}

const { post } = Astro.props;

let Content;
if (typeof render === 'function') {
  const rendered = await render(post);
  Content = rendered.Content;
} else if (typeof post.render === 'function') {
  const rendered = await post.render();
  Content = rendered.Content;
}

const coverImage = post.data.image || '/images/pic01.jpg';

// Resolve recipe properties with fallback for nested recipeInfo objects
const recipeData = {
  servings: post.data.servings ?? post.data.recipeInfo?.servings,
  totalCalories: post.data.totalCalories ?? post.data.recipeInfo?.totalCalories,
  prepTime: post.data.prepTime ?? post.data.recipeInfo?.prepTime,
  cookTime: post.data.cookTime ?? post.data.recipeInfo?.cookTime,
  ingredients: (post.data.ingredients && post.data.ingredients.length > 0)
    ? post.data.ingredients
    : (post.data.recipeInfo?.ingredients ?? []),
  instructions: (post.data.instructions && post.data.instructions.length > 0)
    ? post.data.instructions
    : (post.data.recipeInfo?.instructions ?? []),
};

// Robust recipe detection
const isRecipe =
  post.data.type === 'recipe' ||
  post.data.category?.toLowerCase() === 'recipes' ||
  recipeData.ingredients.length > 0;
---

<BaseLayout
  title={`${post.data.title} | Curiosity Corner`}
  description={post.data.description}
  image={coverImage}
  articleDate={new Date(post.data.pubDate)}
  updatedDate={post.data.updatedDate ? new Date(post.data.updatedDate) : undefined}
  author={post.data.author}
  type={isRecipe ? 'recipe' : 'article'}
  servings={recipeData.servings}
  totalCalories={recipeData.totalCalories}
  prepTime={recipeData.prepTime}
  cookTime={recipeData.cookTime}
  ingredients={recipeData.ingredients}
  instructions={recipeData.instructions}
  hideDefaultHeader={true}
>
  <!-- Blog Cover Hero Banner -->
  <div class="blog-hero" style={`background-image: url('${coverImage}');`}>
    <div class="blog-hero-overlay"></div>

    <div class="blog-hero-top">
      <a href="/" class="logo"><strong>Curiosity Corner</strong></a>
      <ul class="icons">
        <li><a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="icon brands fa-twitter"><span class="label">Twitter</span></a></li>
        <li><a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="icon brands fa-facebook-f"><span class="label">Facebook</span></a></li>
        <li><a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="icon brands fa-instagram"><span class="label">Instagram</span></a></li>
        <li><a href="https://github.com/curiositycornercc" target="_blank" rel="noopener noreferrer" class="icon brands fa-github"><span class="label">GitHub</span></a></li>
      </ul>
    </div>

    <div class="blog-hero-bottom">
      <h1>{post.data.title}</h1>
      <p class="meta">
        Published on {new Date(post.data.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        {post.data.author && <span> by <strong>{post.data.author}</strong></span>}
        {post.data.category && (
          <span> | Category: <a href={`/category/${post.data.category.toLowerCase()}`}>{post.data.category}</a></span>
        )}
      </p>
    </div>
  </div>

  <!-- Main Article Body -->
  <article class="post">
    <!-- "Jump to Recipe" Button for Recipe posts -->
    {isRecipe && (
      <div class="jump-recipe-container">
        <a href="#recipe-card" class="button primary icon solid fa-utensils jump-recipe-btn">
          Jump to Recipe
        </a>
      </div>
    )}

    <div class="content">
      {Content ? <Content /> : <p>No content available.</p>}
    </div>

    <!-- Render Recipe Card if template is Recipe -->
    {isRecipe && (
      <RecipeCard
        title={post.data.title}
        servings={recipeData.servings}
        totalCalories={recipeData.totalCalories}
        prepTime={recipeData.prepTime}
        cookTime={recipeData.cookTime}
        ingredients={recipeData.ingredients}
        instructions={recipeData.instructions}
      />
    )}
  </article>
</BaseLayout>