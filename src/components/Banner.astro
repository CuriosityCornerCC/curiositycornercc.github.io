---
const {
  title = "",
  subtitle = "",
  description = "",
  buttonText = "",
  buttonLink = "",
  imageSrc = ""
} = Astro.props;
---

<section id="banner">
  <div class="content">
    <header>
      <h1>{title}<br />{subtitle}</h1>
    </header>
    <p>{description}</p>
    <ul class="actions">
      <li><a href={buttonLink} class="button big">{buttonText}</a></li>
    </ul>
  </div>
  <span class="image object">
    <img src={imageSrc} alt="" />
  </span>
</section>