---
// Standalone Lightbox Modal Component
---

<div id="lightbox-overlay" class="lightbox-overlay" aria-hidden="true">
  <span class="lightbox-close" title="Close">&times;</span>
  <div class="lightbox-wrapper">
    <img id="lightbox-img" src="" alt="" />
    <p id="lightbox-caption"></p>
  </div>
</div>

<style>
  .lightbox-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(6px);
    z-index: 99999;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.25s ease-in-out;
  }

  .lightbox-overlay.is-active {
    display: flex;
    opacity: 1;
  }

  .lightbox-wrapper {
    max-width: 90vw;
    max-height: 88vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #lightbox-img {
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
    border-radius: 6px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
  }

  #lightbox-caption {
    color: #e0e0e0;
    margin-top: 0.75rem;
    font-size: 0.95rem;
    text-align: center;
  }

  .lightbox-close {
    position: absolute;
    top: 20px;
    right: 30px;
    color: #ffffff;
    font-size: 42px;
    font-weight: bold;
    cursor: pointer;
    line-height: 1;
    transition: color 0.2s ease;
    user-select: none;
  }

  .lightbox-close:hover {
    color: #f56a6a;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const overlay = document.getElementById('lightbox-overlay');
    const lightboxImg = document.getElementById('lightbox-img');
    const caption = document.getElementById('lightbox-caption');
    const closeBtn = document.querySelector('.lightbox-close');

    if (!overlay || !lightboxImg) return;

    const openLightbox = (src, alt) => {
      lightboxImg.src = src;
      lightboxImg.alt = alt || '';
      caption.textContent = alt || '';
      overlay.classList.add('is-active');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden'; // Prevent background scrolling
    };

    const closeLightbox = () => {
      overlay.classList.remove('is-active');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };

    // Attach click handlers to content images & main article images
    const targetImages = document.querySelectorAll('.content img, .post img, span.image.main img');

    targetImages.forEach((img) => {
      // Skip images wrapped inside normal links (unless it's the main header image)
      const parentLink = img.closest('a');
      if (parentLink && !img.closest('span.image.main')) return;

      img.style.cursor = 'zoom-in';

      img.addEventListener('click', (e) => {
        e.preventDefault();
        openLightbox(img.src, img.alt);
      });
    });

    // Close events
    if (closeBtn) closeBtn.addEventListener('click', closeLightbox);

    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) closeLightbox();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay.classList.contains('is-active')) {
        closeLightbox();
      }
    });
  });
</script>