---
const { title = "Curiosity Corner" } = Astro.props;
---

<header id="header">
  <a href="/" class="logo">{title}</a>
  <ul class="icons">
    <li><a href="https://twitter.com" class="icon brands fa-tiktok" target="_blank" rel="noopener noreferrer"><span class="label">TikTok</span></a></li>
    <li><a href="https://facebook.com" class="icon brands fa-facebook-f" target="_blank" rel="noopener noreferrer"><span class="label">Facebook</span></a></li>
    <li><a href="https://instagram.com" class="icon brands fa-instagram" target="_blank" rel="noopener noreferrer"><span class="label">Instagram</span></a></li>
    <li><a href="https://instagram.com" class="icon brands fa-youtube" target="_blank" rel="noopener noreferrer"><span class="label">YouTube</span></a></li>
  </ul>
</header>