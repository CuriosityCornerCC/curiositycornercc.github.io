---
// src/components/GoogleBusinessCard.astro
interface Props {
  name: string;
  category?: string | null;
  rating?: number | null;
  reviewsCount?: number | null;
  address?: string | null;
  locatedIn?: string | null;
  phone?: string | null;
  website?: string | null;
  menu?: string | null;
  hours?: string | null;
  serviceOptions?: string[] | null;
  googleMapsUrl?: string | null;
  mapEmbedUrl?: string | null;
}

const {
  name,
  category,
  rating,
  reviewsCount,
  address,
  locatedIn,
  phone,
  website,
  menu,
  hours,
  serviceOptions,
  googleMapsUrl,
  mapEmbedUrl,
} = Astro.props;

// Safely normalize numeric inputs that might be passed as null or invalid numbers
const safeRating = (rating !== null && rating !== undefined && !isNaN(Number(rating))) ? Number(rating) : undefined;
const safeReviewsCount = (reviewsCount !== null && reviewsCount !== undefined && !isNaN(Number(reviewsCount))) ? Number(reviewsCount) : undefined;

// Calculate star counts safely
const fullStars = safeRating !== undefined ? Math.floor(safeRating) : 0;
const hasHalfStar = safeRating !== undefined ? (safeRating % 1 >= 0.3 && safeRating % 1 <= 0.8) : false;
const emptyStars = safeRating !== undefined ? 5 - fullStars - (hasHalfStar ? 1 : 0) : 5;
---

<div class="google-business-card">
  <!-- Title & Rating Header -->
  <div class="gbc-header">
    <div class="gbc-title-group">
      <h3 class="gbc-name">{name}</h3>
      {category && <span class="gbc-category">{category}</span>}
    </div>

    {safeRating !== undefined && (
      <div class="gbc-rating-row">
        <span class="gbc-score">{safeRating.toFixed(1)}</span>
        <div class="gbc-stars" aria-label={`Rating: ${safeRating} out of 5 stars`}>
          {Array.from({ length: fullStars }).map(() => (
            <span class="star full">★</span>
          ))}
          {hasHalfStar && <span class="star half">★</span>}
          {Array.from({ length: Math.max(0, emptyStars) }).map(() => (
            <span class="star empty">★</span>
          ))}
        </div>
        {safeReviewsCount !== undefined && (
          <span class="gbc-reviews">({safeReviewsCount.toLocaleString()} reviews)</span>
        )}
      </div>
    )}
  </div>

  <!-- Action Buttons -->
  <div class="gbc-actions">
    {website && (
      <a href={website} target="_blank" rel="noopener noreferrer" class="gbc-btn">
        <i class="fas fa-globe"></i> Website
      </a>
    )}
    {googleMapsUrl && (
      <a href={googleMapsUrl} target="_blank" rel="noopener noreferrer" class="gbc-btn primary">
        <i class="fas fa-directions"></i> Directions
      </a>
    )}
  </div>

  <!-- Details List -->
  <div class="gbc-details">
    {serviceOptions && serviceOptions.length > 0 && (
      <div class="gbc-detail-item">
        <span class="gbc-label">Service options:</span>
        <span class="gbc-value">{serviceOptions.join(" · ")}</span>
      </div>
    )}
    {locatedIn && (
      <div class="gbc-detail-item">
        <span class="gbc-label">Located in:</span>
        <span class="gbc-value">{locatedIn}</span>
      </div>
    )}
    {address && (
      <div class="gbc-detail-item">
        <span class="gbc-label">Address:</span>
        <span class="gbc-value">{address}</span>
      </div>
    )}
    {phone && (
      <div class="gbc-detail-item">
        <span class="gbc-label">Phone:</span>
        <span class="gbc-value">
          <a href={`tel:${phone.replace(/\s+/g, '')}`}>{phone}</a>
        </span>
      </div>
    )}
    {menu && (
      <div class="gbc-detail-item">
        <span class="gbc-label">Menu:</span>
        <span class="gbc-value">
          <a href={menu.startsWith('http') ? menu : `https://${menu}`} target="_blank" rel="noopener noreferrer">
            {menu.replace(/^https?:\/\//, '')}
          </a>
        </span>
      </div>
    )}
    {hours && (
      <div class="gbc-detail-item">
        <span class="gbc-label">Hours:</span>
        <span class="gbc-value status-open">{hours}</span>
      </div>
    )}
  </div>

  <!-- Embedded Map Preview -->
  {mapEmbedUrl && (
    <div class="gbc-map">
      <iframe
        src={mapEmbedUrl}
        width="100%"
        height="180"
        style="border:0; border-radius: 8px;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title={`Map for ${name}`}
      ></iframe>
    </div>
  )}
</div>