---
// src/components/GoogleBusinessCard.astro
interface Props {
  name: string;
  category?: string;
  rating?: number;
  reviewsCount?: number;
  address?: string;
  locatedIn?: string;
  phone?: string;
  website?: string;
  menu?: string;
  hours?: string;
  serviceOptions?: string[];
  googleMapsUrl?: string;
  mapEmbedUrl?: string;
}

const {
  name,
  category = "Restaurant",
  rating = 4.2,
  reviewsCount = 142,
  address,
  locatedIn,
  phone,
  website,
  menu,
  hours = "Open · Closes 9 PM",
  serviceOptions = [],
  googleMapsUrl,
  mapEmbedUrl,
} = Astro.props;

const fullStars = Math.floor(rating);
const hasHalfStar = rating % 1 >= 0.3 && rating % 1 <= 0.8;
const emptyStars = 5 - fullStars - (hasHalfStar ? 1 : 0);
---

<div class="google-business-card">
  <div class="gbc-header">
    <div class="gbc-title-group">
      <h3 class="gbc-name">{name}</h3>
      {category && <span class="gbc-category">{category}</span>}
    </div>

    {rating !== undefined && (
      <div class="gbc-rating-row">
        <span class="gbc-score">{rating.toFixed(1)}</span>
        <div class="gbc-stars" aria-label={`Rating: ${rating} out of 5 stars`}>
          {Array.from({ length: fullStars }).map(() => (
            <span class="star full">★</span>
          ))}
          {hasHalfStar && <span class="star half">★</span>}
          {Array.from({ length: Math.max(0, emptyStars) }).map(() => (
            <span class="star empty">★</span>
          ))}
        </div>
        {reviewsCount !== undefined && (
          <span class="gbc-reviews">({reviewsCount.toLocaleString()} reviews)</span>
        )}
      </div>
    )}
  </div>

  <div class="gbc-actions">
    {website && (
      <a href={website} target="_blank" rel="noopener noreferrer" class="gbc-btn">
        <i class="fas fa-globe"></i> Website
      </a>
    )}
    {googleMapsUrl && (
      <a href={googleMapsUrl} target="_blank" rel="noopener noreferrer" class="gbc-btn primary">
        <i class="fas fa-directions"></i> Directions
      </a>
    )}
  </div>

  <div class="gbc-details">
    {serviceOptions && serviceOptions.length > 0 && (
      <div class="gbc-detail-item">
        <span class="gbc-label">Service options:</span>
        <span class="gbc-value">{serviceOptions.join(" · ")}</span>
      </div>
    )}
    {locatedIn && (
      <div class="gbc-detail-item">
        <span class="gbc-label">Located in:</span>
        <span class="gbc-value">{locatedIn}</span>
      </div>
    )}
    {address && (
      <div class="gbc-detail-item">
        <span class="gbc-label">Address:</span>
        <span class="gbc-value">{address}</span>
      </div>
    )}
    {phone && (
      <div class="gbc-detail-item">
        <span class="gbc-label">Phone:</span>
        <span class="gbc-value">
          <a href={`tel:${phone.replace(/\s+/g, '')}`}>{phone}</a>
        </span>
      </div>
    )}
    {menu && (
      <div class="gbc-detail-item">
        <span class="gbc-label">Menu:</span>
        <span class="gbc-value">
          <a href={menu.startsWith('http') ? menu : `https://${menu}`} target="_blank" rel="noopener noreferrer">
            {menu.replace(/^https?:\/\//, '')}
          </a>
        </span>
      </div>
    )}
    {hours && (
      <div class="gbc-detail-item">
        <span class="gbc-label">Hours:</span>
        <span class="gbc-value status-open">{hours}</span>
      </div>
    )}
  </div>

  {mapEmbedUrl && (
    <div class="gbc-map">
      <iframe
        src={mapEmbedUrl}
        width="100%"
        height="180"
        style="border:0; border-radius: 8px;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title={`Map for ${name}`}
      ></iframe>
    </div>
  )}
</div>