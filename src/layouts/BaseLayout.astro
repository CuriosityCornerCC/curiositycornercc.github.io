---
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import Lightbox from '../components/Lightbox.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  articleDate?: Date;
  updatedDate?: Date;
  author?: string;
  type?: 'article' | 'recipe' | 'website';
  hideDefaultHeader?: boolean;
  // Recipe SEO props
  servings?: number | string;
  totalCalories?: number | string;
  prepTime?: string;
  cookTime?: string;
  ingredients?: string[];
  instructions?: string[];
}

const {
  title,
  description = "A modern high-performance blog.",
  image = "/images/pic01.jpg",
  articleDate,
  updatedDate,
  author = "Curiosity Corner",
  type = "website",
  hideDefaultHeader = false,
  servings,
  totalCalories,
  prepTime,
  cookTime,
  ingredients = [],
  instructions = []
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://curiositycornercc.github.io");
const socialImageURL = new URL(image, Astro.site || "https://curiositycornercc.github.io");

// Dynamic Schema.org JSON-LD generation
let jsonLdSchema: Record<string, any> | null = null;

if (type === "article") {
  jsonLdSchema = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "image": [socialImageURL.href],
    "datePublished": articleDate ? articleDate.toISOString() : undefined,
    "dateModified": updatedDate ? updatedDate.toISOString() : (articleDate ? articleDate.toISOString() : undefined),
    "author": {
      "@type": "Person",
      "name": author
    },
    "publisher": {
      "@type": "Organization",
      "name": "Curiosity Corner",
      "logo": {
        "@type": "ImageObject",
        "url": new URL("/Curiosity_Corner_Logo_2.svg", Astro.site || "https://curiositycornercc.github.io").href
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": canonicalURL.href
    }
  };
} else if (type === "recipe") {
  jsonLdSchema = {
    "@context": "https://schema.org",
    "@type": "Recipe",
    "name": title,
    "description": description,
    "image": [socialImageURL.href],
    "author": {
      "@type": "Person",
      "name": author
    },
    "datePublished": articleDate ? articleDate.toISOString() : undefined,
    "dateModified": updatedDate ? updatedDate.toISOString() : (articleDate ? articleDate.toISOString() : undefined),
    "recipeYield": servings ? `${servings} servings` : undefined,
    "prepTime": prepTime,
    "cookTime": cookTime,
    "nutrition": totalCalories ? {
      "@type": "NutritionInformation",
      "calories": `${totalCalories} calories`
    } : undefined,
    "recipeIngredient": ingredients,
    "recipeInstructions": instructions.map((step) => ({
      "@type": "HowToStep",
      "text": step
    }))
  };
}
---

<!doctype html>
<html lang="en" style="scroll-behavior: smooth;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Open Graph / Social Tags -->
    <meta property="og:type" content={type === 'recipe' ? 'article' : type} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL.href} />
    <meta property="og:site_name" content="Curiosity Corner" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL.href} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL.href} />

    {articleDate && <meta property="article:published_time" content={articleDate.toISOString()} />}

    {jsonLdSchema && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLdSchema)} />
    )}

    <link rel="stylesheet" href="/assets/css/fontawesome-all.min.css" />
    <link rel="stylesheet" href="/assets/css/main.css" />

    <!-- Brand Stylesheet -->
    <link rel="stylesheet" href="/assets/css/curiosity-corner-theme.css" />
    
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-61XSPRKWJP"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-61XSPRKWJP');
    </script>
  </head>
  <body>
    <div id="wrapper">
      <div id="main">
        <div class="inner">
          {!hideDefaultHeader && <Header />}
          <slot />
        </div>
      </div>
      <Sidebar />
    </div>

    <Lightbox />

    <script is:inline src="/assets/js/jquery.min.js"></script>
    <script is:inline src="/assets/js/browser.min.js"></script>
    <script is:inline src="/assets/js/breakpoints.min.js"></script>
    <script is:inline src="/assets/js/util.js"></script>
    <script is:inline src="/assets/js/main.js"></script>
  </body>
</html>