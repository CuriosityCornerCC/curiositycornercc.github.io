---
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import Lightbox from '../components/Lightbox.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  articleDate?: Date;
  updatedDate?: Date;
  author?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = "A modern high-performance static website built with Astro and Sveltia CMS.",
  image = "/images/pic01.jpg",
  articleDate,
  updatedDate,
  author = "Curiosity Corner",
  type = "website",
} = Astro.props;

// Build absolute URLs for Open Graph images and canonical links
const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://curiositycornercc.github.io");
const socialImageURL = new URL(image, Astro.site || "https://curiositycornercc.github.io");

// Generate JSON-LD Schema for Google Rich Snippets
const jsonLdSchema = type === "article" ? {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "image": socialImageURL.href,
  "datePublished": articleDate ? articleDate.toISOString() : undefined,
  "dateModified": updatedDate ? updatedDate.toISOString() : (articleDate ? articleDate.toISOString() : undefined),
  "author": {
    "@type": "Person",
    "name": author
  },
  "publisher": {
    "@type": "Organization",
    "name": "Curiosity Corner",
    "logo": {
      "@type": "ImageObject",
      "url": new URL("/Curiosity_Corner_Logo_2.svg", Astro.site || "https://curiositycornercc.github.io").href
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL.href
  }
} : null;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Standard Meta Tags -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL.href} />
    <meta property="og:site_name" content="Curiosity Corner" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL.href} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL.href} />

    {articleDate && <meta property="article:published_time" content={articleDate.toISOString()} />}

    <!-- JSON-LD Structured Data -->
    {jsonLdSchema && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLdSchema)} />
    )}

    <!-- Stylesheets -->
    <link rel="stylesheet" href="/assets/css/fontawesome-all.min.css" />
    <link rel="stylesheet" href="/assets/css/main.css" />
  </head>
  <body>
    <div id="wrapper">
      <div id="main">
        <div class="inner">
          <Header />
          <slot />
        </div>
      </div>
      <Sidebar />
    </div>

    <Lightbox />

    <!-- Core Scripts -->
    <script is:inline src="/assets/js/jquery.min.js"></script>
    <script is:inline src="/assets/js/browser.min.js"></script>
    <script is:inline src="/assets/js/breakpoints.min.js"></script>
    <script is:inline src="/assets/js/util.js"></script>
    <script is:inline src="/assets/js/main.js"></script>
  </body>
</html>